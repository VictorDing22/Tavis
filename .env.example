# ============================================================
# SuperUnknown 门户网站 — 环境变量
# 复制此文件为 .env.local 并填写实际值
# ============================================================

# Resend 邮件服务 API Key
# 注册地址: https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接收联系表单邮件的邮箱地址
CONTACT_EMAIL=your-email@example.com

# 发件地址（可选）
# 默认使用 Resend 测试发件人 "SuperUnknown <onboarding@resend.dev>"，
# 该地址只能发往 Resend 账号的注册邮箱。
# 在 Resend 验证 tavis.com.cn 域名后，改为：
# RESEND_FROM_EMAIL=SuperUnknown <noreply@tavis.com.cn>
